# Copy this file to .env and fill in your key. .env is git-ignored.
# Without a key the app still runs — the conference falls back to a scripted
# Socratic guide so you can see the full UX. With a key, conferences are live.
ANTHROPIC_API_KEY=
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=8788

# --- Path Library (the publisher platform) ---
# Leave SUPABASE_URL blank and the library stores content in server/library.json,
# which is what local development uses. Set both and it uses the database.
# The service key is server-only: it must never appear in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# One shared key for the publisher console. Blank = open (local only).
PUBLISHER_PASSCODE=

# --- Solution videos on Cloudflare R2 ---
# Leave VITE_MEDIA_BASE unset and videos are served from the app's own
# /solutions folder. Set it to the bucket's public URL (trailing slash) and the
# app loads them from R2 instead. Activities store a video id, never a URL.
VITE_MEDIA_BASE=

# Upload credentials — used only by tools/upload-media.mjs, never by the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Drafting activities from a deck ---
# The model call belongs to ClearK12 Studio: one key to rotate, no product
# holding it, and every draft counted in the master cost log. Point this at the
# Studio and leave ANTHROPIC_API_KEY empty.
STUDIO_AI_URL=
STUDIO_AI_KEY=

# Direct fallback, for a laptop or before the Studio is up. Either one works;
# the Studio wins if both are set.
# ANTHROPIC_API_KEY=
